{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Thompson",
  "version": "0.1.1",
  "identifier": "com.thompson.assistant",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Thompson",
        "width": 420,
        "height": 640,
        "decorations": true,
        "resizable": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
